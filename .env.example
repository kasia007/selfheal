# 이 파일을 `.env` 로 복사해서 값을 채우십시오. `.env` 는 .gitignore 에 있습니다.
# src/agent.py 의 load_dotenv_if_present() 가 실행 시 읽습니다.
# (프로젝트 폴더부터 위로 올라가며 찾으므로, 저장소 루트에 하나만 둬도 됩니다.)

# ── Bedrock 자격증명 (필수) ─────────────────────────────────
# AGENTS.md 고정 스택: Claude Sonnet 4.5 + Titan 임베딩, us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── LangSmith 추적 (선택, 기본 꺼짐) ────────────────────────
#
# ⚠️ 주의 — 추적을 켜면 프롬프트가 외부 서비스로 전송됩니다.
#    그 프롬프트에는 **검수 대상 소스 코드 전문**이 들어 있습니다.
#    이 프로젝트는 "승인 전까지 원본을 건드리지 않는다"(G6)를 약속하므로,
#    코드를 외부로 보내는 동작도 사용자가 명시적으로 켜야만 일어납니다.
#
# 아래 두 값이 **둘 다** 있어야 켜집니다. 하나만 있으면 켜지지 않습니다
# (키 없이 켜면 401 오류 덤프가 화면을 뒤덮기 때문입니다).
# 켜지면 실행 시 `🔭 LangSmith 추적 활성` 이 표시되고,
# .heal/report.json 의 trace_enabled 가 true 로 기록됩니다.
#
# 추적을 켜지 않아도 프롬프트·응답 전문은 .heal/trace.log 에 로컬로 남습니다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=selfheal
